# Gemini API Key từ Google AI Studio
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Model mặc định (tùy chọn)
VITE_DEFAULT_CHAT_MODEL=gemini-2.0-flash
VITE_DEFAULT_IMAGE_MODEL=imagen-3
VITE_DEFAULT_VIDEO_MODEL=veo-2

# Media proxy (dev only)
VITE_MEDIA_PROXY_ENDPOINT=/api/media-proxy
VITE_MEDIA_PROXY_ENABLED=true
