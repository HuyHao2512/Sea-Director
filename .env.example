# 1. Trỏ API mặc định về KIE
VITE_API_BASE_URL=https://api.kie.ai

# 2. Điền token KIE của bạn vào đây
VITE_API_KEY=9bc921e476b0b5d61597dcbb207fdec6

# 3. Bật Proxy để tải ảnh/video từ KIE mà không bị lỗi CORS
VITE_MEDIA_PROXY_ENABLED=true
MEDIA_PROXY_PORT=8787
MEDIA_PROXY_ALLOWED_HOSTS=kie.ai,googleusercontent.com,volces.com

# 4. Ghi đè model mặc định (Tùy chọn, để khi mở web là nó chọn sẵn model KIE)
VITE_DEFAULT_CHAT_MODEL=gemini-2.5-flash
VITE_DEFAULT_IMAGE_MODEL=nano-banana-2
VITE_DEFAULT_VIDEO_MODEL=veo3_fast